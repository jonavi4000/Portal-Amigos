# Copia este archivo como ".env" y cambia los valores

# Puerto donde corre el servidor local
PORT=3000

# Clave secreta para las sesiones (pon cualquier texto largo y raro)
SESSION_SECRET=cambia-esto-por-un-texto-secreto-largo

# Contrasena del panel de administrador (Vanessa)
ADMIN_PASSWORD=cambia-esta-clave

# Prefijo y ancho minimo del codigo de referido (AMIGOS01, AMIGOS02...)
PREFIJO_CODIGO=AMIGOS
ANCHO_CODIGO=2

# ---- Pantalla final de registro: botones de WhatsApp ----
# Nombre del candidato/campana, se muestra en el mensaje de agradecimiento
CANDIDATO_NOMBRE=nuestro candidato

# Numero de WhatsApp SIN signos ni espacios, con indicativo de pais
# (ya quedo con el +57 de Colombia puesto)
WHATSAPP_NUMERO=573217674230

# Link de tu canal o grupo oficial de WhatsApp (opcional).
# Si no tienes uno todavia, deja esta linea vacia y ese boton no aparecera.
WHATSAPP_CANAL_URL=

# ---- Nomina / bonificaciones (solo admin) ----
# Un lider se habilita cuando tiene NOMINA_MIN_DIRECTOS personas registradas por el,
# y NOMINA_MIN_RAMAS de ellas (lideres) registraron a su vez NOMINA_MIN_POR_RAMA cada una.
# Si no pones nada, los tres valores son 10.
NOMINA_MIN_DIRECTOS=10
NOMINA_MIN_RAMAS=10
NOMINA_MIN_POR_RAMA=10
